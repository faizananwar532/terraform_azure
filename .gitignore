# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# *.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local dev overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore backend configuration with sensitive data
# backend.tfvars

# Ignore .terraform.lock.hcl which contains provider versions
.terraform.lock.hcl

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Kubeconfig files
kubeconfig*
.kube/